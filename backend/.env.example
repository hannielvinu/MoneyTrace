# ==============================================================================
# MoneyTrace — Environment Configuration
# ==============================================================================

# LLM Reasoning Engine (OpenAI / Azure OpenAI / Anthropic / Compatible Endpoint)
LLM_API_KEY=your_llm_api_key_here

# Sarvam AI — Speech-to-Text (STT) & Text-to-Speech (TTS) Multilingual Engine
# Supports English, Hindi, Tamil, Kannada
SARVAM_API_KEY=your_sarvam_api_key_here 

# Cognee Cloud — Relationship & Context Intelligence Layer
# Automatically correlates entities across incidents to uncover scam syndicates
COGNEE_API_KEY=your_cognee_api_key_here
COGNEE_BASE_URL=https://api.cognee.ai

# n8n Pro — Autonomous Response Workflow Automation Webhook
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/moneytrace-incident

# JWT Secret for User & Fraud Operator Authentication
JWT_SECRET=moneytrace-super-secret-key-2026-secure

# Server Port
PORT=8000
